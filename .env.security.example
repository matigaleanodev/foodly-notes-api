# Supplement .env.example; never store real credentials in tracked files.
NODE_ENV=production
ENFORCE_HTTPS=true
# Set the real reverse-proxy IPs/subnets. Never trust arbitrary clients.
# TRUST_PROXY=172.30.0.10/32
CORS_ORIGIN=https://foodlynotes.app,http://localhost,capacitor://localhost
SWAGGER_ENABLED=false
RATE_LIMIT_PER_ROUTE=30
RATE_LIMIT_GLOBAL=120
PROVIDER_MAX_CONCURRENCY=4
SPOONACULAR_DAILY_REQUEST_LIMIT=100
AZURE_DAILY_CHARACTER_LIMIT=50000
