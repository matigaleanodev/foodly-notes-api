# Local development. Use Node 24 and keep real credentials in an ignored .env.
NODE_ENV=development
PORT=3000

MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_url>/<database_name>?retryWrites=true&w=majority

# Web production origin: https://foodlynotes.app
# Capacitor Android origin: http://localhost
# Capacitor iOS origin: capacitor://localhost
# Use a comma-separated allowlist without trailing slashes.
CORS_ORIGIN=https://foodlynotes.app,http://localhost,capacitor://localhost

SPOONACULAR_API_KEY=your_spoonacular_api_key
SPOONACULAR_BASE_URL=https://api.spoonacular.com


AZURE_TRANSLATOR_KEY=your_azure_translator_key
AZURE_TRANSLATOR_REGION=southcentralus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Shared MongoDB-backed rate limits (requests per IP per minute).
# Search/similar: 20/min; ingredients: 10/min; health is exempt.
RATE_LIMIT_PER_ROUTE=30
RATE_LIMIT_GLOBAL=120
PROVIDER_MAX_CONCURRENCY=4
# Daily UTC budgets, shared between instances; failed attempts also count.
SPOONACULAR_DAILY_REQUEST_LIMIT=100
AZURE_DAILY_CHARACTER_LIMIT=50000

# Defaults: HTTPS required in production; Swagger enabled outside production.
# For production set NODE_ENV=production and see .env.security.example.
# TRUST_PROXY must list the actual proxy addresses/subnets, never true or '*'.
# TRUST_PROXY=172.30.0.10/32
# ENFORCE_HTTPS=true
# SWAGGER_ENABLED=false
